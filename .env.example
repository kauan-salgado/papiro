# ---------------------------------------------------------------------------
# Copie para .env antes do primeiro `docker compose up`.
# O .env real fica fora do versionamento (ver .gitignore).
# ---------------------------------------------------------------------------

# Banco (usado pelo container do Postgres e montado no DATABASE_URL da API)
POSTGRES_USER=papiro
POSTGRES_PASSWORD=papiro
POSTGRES_DB=papiro
POSTGRES_PORT=5433

# API
API_PORT=3333
NODE_ENV=development
# Protege a vitrine publica: bloqueia apagar edital e substituir importacao.
# Ligue apenas no ambiente hospedado.
MODO_DEMO=false
# Abre uma vitrine somente leitura para quem nao entrou: o visitante ve a conta
# de demonstracao e nao consegue escrever nada.
VITRINE_PUBLICA=false

# OAuth App do GitHub (github.com/settings/developers). Sem eles, o login fica
# indisponivel e a API diz isso claramente.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Adminer (debug do banco via navegador)
ADMINER_PORT=8081

# Frontend (Vite roda fora do compose, no host)
WEB_PORT=5173
