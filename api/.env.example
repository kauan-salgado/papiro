# Usado apenas pela CLI do Prisma quando executada a partir do HOST
# (migrate, generate, studio, seed). Dentro do compose, o docker-compose.yml
# injeta DATABASE_URL apontando para o host "db" na porta 5432 — e a variavel
# injetada tem precedencia sobre este arquivo.
DATABASE_URL="postgresql://papiro:papiro@localhost:5433/papiro?schema=public"

# Somente em ambiente hospedado (Neon): conexao direta, sem pooler, usada
# pelas migrations. Em desenvolvimento local pode ficar em branco.
# DIRECT_DATABASE_URL="postgresql://...neon.tech/papiro?sslmode=require"
