// ---------------------------------------------------------------------------
// Papiro — modelo de dominio
//
// Hierarquia: Concurso -> Cargo -> Disciplina -> Topico -> Sessao de Estudo
//
// Duas regras que NAO cabem neste arquivo e vivem na migration escrita a mao
// (prisma/migrations/*_constraints_e_views/migration.sql):
//   1. CHECK constraints (o Prisma Schema Language nao os representa)
//   2. Views de dashboard (vw_desempenho_disciplina / vw_desempenho_topico)
// Elas sao parte do contrato do banco. Ver db/schema.sql e db/views.sql.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Tipo de estudo de uma sessao. Simulado NAO e um valor daqui:
/// simulado e entidade propria, porque agrupa varias sessoes.
enum TipoEstudo {
  Teoria
  Revisao  @map("Revisão")
  Resumo
  Questoes @map("Questões")

  @@map("tipo_estudo_enum")
}

/// Quem estuda. A identidade vem do GitHub: o projeto nao guarda senha de
/// ninguem, e por isso nao tem como vazar uma.
model Usuario {
  id        Int      @id @default(autoincrement())
  /// Identificador numerico do GitHub — imutavel, ao contrario do login.
  githubId  String   @unique @map("github_id") @db.VarChar(40)
  login     String   @db.VarChar(80)
  nome      String?  @db.VarChar(120)
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  concursos    Concurso[]
  sessoesAuth  SessaoAuth[]

  @@map("usuarios")
}

/// Sessao de login. Fica no banco, e nao em JWT, para poder ser revogada:
/// sair de verdade precisa invalidar o que ja foi emitido.
model SessaoAuth {
  /// Token opaco sorteado no servidor; e o que viaja no cookie httpOnly.
  token     String   @id @db.VarChar(64)
  usuarioId Int      @map("usuario_id")
  expiraEm  DateTime @map("expira_em") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId], map: "idx_sessoes_auth_usuario")
  @@index([expiraEm], map: "idx_sessoes_auth_expiracao")
  @@map("sessoes_auth")
}

/// Nivel raiz do edital, e a ancora da autorizacao: tudo abaixo pertence ao
/// dono deste registro. Uma unica clausula `usuarioId` protege a hierarquia
/// inteira — cargo, disciplina, topico, sessao e simulado.
model Concurso {
  id        Int       @id @default(autoincrement())
  usuarioId Int       @map("usuario_id")
  nome      String    @db.VarChar(150)
  banca     String?   @db.VarChar(80)
  dataProva DateTime? @map("data_prova") @db.Date
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  cargos  Cargo[]

  @@index([usuarioId], map: "idx_concursos_usuario")
  @@map("concursos")
}

model Cargo {
  id         Int    @id @default(autoincrement())
  concursoId Int    @map("concurso_id")
  nome       String @db.VarChar(150)

  concurso    Concurso       @relation(fields: [concursoId], references: [id], onDelete: Cascade)
  disciplinas Disciplina[]
  simulados   Simulado[]
  sessoes     SessaoEstudo[]

  @@map("cargos")
}

model Disciplina {
  id      Int      @id @default(autoincrement())
  cargoId Int      @map("cargo_id")
  nome    String   @db.VarChar(120)
  /// Peso da disciplina na prova. Decimal, nao float: peso e nota, nao medida fisica.
  peso    Decimal? @default(1) @db.Decimal(4, 2)

  cargo   Cargo          @relation(fields: [cargoId], references: [id], onDelete: Cascade)
  topicos Topico[]
  sessoes SessaoEstudo[]

  @@unique([cargoId, nome])
  /// Alvo da chave estrangeira composta em sessoes_estudo: garante no banco
  /// que a disciplina informada na sessao pertence ao cargo informado.
  @@unique([id, cargoId])
  @@map("disciplinas")
}

model Topico {
  id           Int     @id @default(autoincrement())
  disciplinaId Int     @map("disciplina_id")
  /// Numeracao literal do edital ("17.1", "7.4.2"). Cada banca numera do seu jeito.
  codigoEdital String? @map("codigo_edital") @db.VarChar(20)
  /// Texto literal do item do edital, sem reescrita.
  descricao    String
  /// Ordem de exibicao no edital verticalizado.
  ordem        Int?

  disciplina Disciplina     @relation(fields: [disciplinaId], references: [id], onDelete: Cascade)
  sessoes    SessaoEstudo[]

  @@unique([disciplinaId, codigoEdital])
  /// Mesma ideia: amarra o topico da sessao a disciplina informada.
  @@unique([id, disciplinaId])
  @@map("topicos")
}

/// Agrupa varias sessoes (uma por disciplina coberta), permitindo tanto a visao
/// granular por topico quanto a consolidada do simulado inteiro.
model Simulado {
  id      Int      @id @default(autoincrement())
  cargoId Int      @map("cargo_id")
  nome    String   @db.VarChar(150)
  data    DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date

  cargo   Cargo          @relation(fields: [cargoId], references: [id], onDelete: Cascade)
  sessoes SessaoEstudo[]

  @@map("simulados")
}

/// Fact table. Uma linha por sessao realizada, nunca um contador mutavel.
/// Todo agregado (minutos, % de acerto) e SUM/GROUP BY em cima daqui.
model SessaoEstudo {
  id Int @id @default(autoincrement())

  /// Onde o estudo entra. Sempre ha um cargo; disciplina e topico refinam.
  ///   topico preenchido  -> estudo de um item do edital
  ///   so disciplina      -> bateria avulsa da materia ("30 questoes de SI")
  ///   so cargo           -> simulado da prova inteira
  /// As chaves estrangeiras compostas abaixo impedem combinacao incoerente:
  /// disciplina de outro cargo, ou topico de outra disciplina.
  cargoId      Int  @map("cargo_id")
  disciplinaId Int? @map("disciplina_id")
  topicoId     Int? @map("topico_id")

  /// Opcional: nem toda sessao pertence a um simulado.
  simuladoId Int? @map("simulado_id")

  data DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date
  /// Somente minutos. Conversao para horas e da camada de apresentacao.
  tempoMinutos Int        @map("tempo_minutos")
  tipoEstudo   TipoEstudo @map("tipo_estudo")

  /// Obrigatorios quando tipoEstudo = Questoes, nulos caso contrario.
  /// Regra imposta por CHECK constraint (chk_questoes_obrigatorias).
  questoesAcertadas Int? @map("questoes_acertadas")
  questoesErradas   Int? @map("questoes_erradas")
  questoesBrancas   Int? @map("questoes_brancas")

  observacoes String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  cargo      Cargo       @relation(fields: [cargoId], references: [id], onDelete: Cascade)
  disciplina Disciplina? @relation(fields: [disciplinaId, cargoId], references: [id, cargoId], onDelete: Cascade)
  topico     Topico?     @relation(fields: [topicoId, disciplinaId], references: [id, disciplinaId], onDelete: Cascade)
  simulado   Simulado?   @relation(fields: [simuladoId], references: [id], onDelete: SetNull)

  @@index([topicoId], map: "idx_sessoes_topico")
  @@index([disciplinaId], map: "idx_sessoes_disciplina")
  @@index([cargoId], map: "idx_sessoes_cargo")
  @@index([data], map: "idx_sessoes_data")
  @@map("sessoes_estudo")
}
